{
  "id": "dsh-infra",
  "name": "@local/dsh-infra",
  "displayName": "Infra · 机器与仓库公共知识库",
  "version": "0.1.1",
  "repo": "https://github.com/ChrisZqaq/dsh-infra",
  "repoPath": "dsh-infra",
  "entry": "index.js",
  "clientEntry": "client.js",
  "bundlePatch": "cordis.patch.yml",
  "hostDirs": [
    "host"
  ],
  "localeDirs": [
    "locale"
  ],
  "docs": [
    "README.md",
    "design/layout-prototype.png",
    "design/layout-prototype-v2.png"
  ],
  "install": "github:ChrisZqaq/dsh-infra",
  "update": "dsh plugin --profile desktop add github:ChrisZqaq/dsh-infra",
  "verify": "node scripts/verify.mjs",
  "slots": [
    "sidebar-footer.right",
    "conversation-view.tab"
  ],
  "routes": [
    "GET /dsh-infra/state",
    "GET /dsh-infra/hosts",
    "POST /dsh-infra/hosts",
    "POST /dsh-infra/check"
  ],
  "services": [],
  "notes": [
    "全局 ~/.dsh/infra/infra.yml + 项目级 <workspace>/.dsh/infra.yml，同名 id 项目级覆盖全局。",
    "三个界面（侧栏入口 / 主区域面板 / 对话区仓库视图）读同一份 YAML 与同一组宿主路由。",
    "rules 是自定义正则拦截，匹配危险命令时给出 reason。"
  ]
}
